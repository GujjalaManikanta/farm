# ===============================================
# AgriSmart AI – Environment Variables & Database Config
# ===============================================

# 1. Cloud Database Connection (Supabase / PostgreSQL)
# Create a free project at https://supabase.com or Neon/Railway
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres

# 2. Application Config
VITE_APP_TITLE=AgriSmart AI
VITE_DEFAULT_LANGUAGE=te
PORT=8080
